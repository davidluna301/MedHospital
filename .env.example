# Variables para despliegue (Render / Railway / producción)
DJANGO_SECRET_KEY=cambie-esto-en-produccion
DJANGO_DEBUG=False
# En Render suele bastar RENDER_EXTERNAL_HOSTNAME automático; dominio propio:
DJANGO_ALLOWED_HOSTS=su-app.onrender.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://su-app.onrender.com
DATABASE_URL=postgres://usuario:pass@host:5432/nombrebd
SERVE_MEDIA=True
# MEDIA_ROOT=/opt/render/project/src/media
SECURE_SSL_REDIRECT=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ConsultaMed <noreply@su-dominio.com>
